rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isAdmin() {
      return isAuth() && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
    function isPremium() {
      return isAuth() && (
        request.auth.token.role == 'premium' ||
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['premium', 'admin']
      );
    }
    function owns(uid) { return isAuth() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if owns(uid) || isAdmin();
      allow create: if false;
      allow update: if (owns(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['pinHash','role','paymentStatus','premiumUntil','failedAttempts','lockedUntil']))
        || isAdmin();
      allow delete: if isAdmin();

      match /notifications/{nid} {
        allow read, update: if owns(uid);
        allow create: if false;
      }

      match /audit/{lid} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // El dueño no puede reasignar el documento a otro veterinario
    function keepsOwner() {
      return request.resource.data.vetId == resource.data.vetId;
    }

    match /pets/{petId} {
      allow read, delete: if owns(resource.data.vetId) || isAdmin();
      allow update: if (owns(resource.data.vetId) && keepsOwner()) || isAdmin();
      allow create: if isAuth() && request.resource.data.vetId == request.auth.uid;
    }

    match /appointments/{id} {
      allow read, delete: if owns(resource.data.vetId) || isAdmin();
      allow update: if (owns(resource.data.vetId) && keepsOwner()) || isAdmin();
      allow create: if isAuth() && request.resource.data.vetId == request.auth.uid;
    }

    match /treatments/{id} {
      allow read, delete: if owns(resource.data.vetId) || isAdmin();
      allow update: if (owns(resource.data.vetId) && keepsOwner()) || isAdmin();
      allow create: if isAuth() && request.resource.data.vetId == request.auth.uid;
    }

    match /history/{id} {
      allow read: if owns(resource.data.vetId) || isAdmin();
      allow create: if isAuth() && request.resource.data.vetId == request.auth.uid;
      allow update, delete: if false;
    }

    match /medications/{medId} {
      allow read: if isAuth();
      allow create: if isAdmin() ||
        (isPremium() && request.resource.data.isGlobal == false &&
          request.resource.data.createdBy == request.auth.uid);
      // Premium solo puede modificar/borrar SUS medicamentos privados (nunca los globales)
      allow update: if isAdmin() ||
        (isPremium() && resource.data.isGlobal == false &&
          resource.data.createdBy == request.auth.uid &&
          request.resource.data.isGlobal == false &&
          request.resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin() ||
        (isPremium() && resource.data.isGlobal == false &&
          resource.data.createdBy == request.auth.uid);
    }

    match /payment_requests/{id} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /payment_history/{id} {
      allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /login_attempts/{id} {
      allow read, write: if false;
    }

    match /bcv_rates/{date} {
      allow read: if isAuth();
      allow write: if false;
    }

    match /system/{doc} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}
